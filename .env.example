# Скопируйте в .env и подставьте свои значения.
# .env в git не коммитится. Ключ заметок на сервер не отправляется.

# Компьютер
# QR для телефона: ./scripts/show-qr.sh имя-телефона
SYNC_SERVER=http://203.0.113.10:8787
SYNC_VAULT=/path/to/vault
SYNC_KEY=~/.config/magic-sync/sync.key
SYNC_DEVICE=computer

# Сервер. На VPS уходит только этот блок.
MAGIC_SYNC_TOKEN=замените-на-длинный-токен
MAGIC_SYNC_LISTEN=0.0.0.0:8787
MAGIC_SYNC_DATA=/opt/magic-sync/data
MAGIC_SYNC_JAVA=/usr/bin/java

# Деплой по SSH
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_REMOTE_DIR=/opt/magic-sync
